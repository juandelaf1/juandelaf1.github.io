---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../config/site';
import { getLocaleFromUrl } from '../i18n/utils';
import { getUI } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  tech: Array<{ name: string; icon?: string }>;
  links: { github?: string; demo?: string; docs?: string };
  image?: string;
}

const { title, description, category, date, tech, links, image } = Astro.props;
const techList = tech.map((t) => t.name);
const locale = ((Astro.currentLocale as 'en' | 'es') ?? getLocaleFromUrl(Astro.url));
const t = getUI(locale);
---

<BaseLayout
  title={`${title} — ${SITE.author}`}
  {description}
  image={image}
  path={locale === 'es' ? `/es/projects/${Astro.params.slug}` : `/projects/${Astro.params.slug}`}
  currentPath={locale === 'es' ? `/es/projects/${Astro.params.slug}` : `/projects/${Astro.params.slug}`}
>
  <Container>
    <article class="case-study">
      <header class="header">
        <a href={locale === 'es' ? '/es/projects' : '/projects'} class="back">&larr; {t.caseStudy.backToProjects}</a>
        <div class="meta">
          <Tag text={category} />
          <time datetime={date.toISOString()} class="date">
            {new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-US', { year: 'numeric', month: 'long' }).format(date)}
          </time>
        </div>
        <h1 class="title">{title}</h1>
        <p class="description">{description}</p>
        {image && (
          <figure class="hero-image">
            <img src={image} alt={`${title} — architecture / dashboard`} loading="lazy" />
          </figure>
        )}
        <div class="actions">
          {links.github && (
            <Button href={links.github} variant="primary" external>{t.caseStudy.viewRepository}</Button>
          )}
          {links.demo && (
            <Button href={links.demo} variant="ghost" external>{t.caseStudy.liveDemo}</Button>
          )}
          {links.docs && (
            <Button href={links.docs} variant="ghost" external>{t.caseStudy.documentation}</Button>
          )}
        </div>
        <div class="tech-row">
          {techList.map((tech) => (
            <span class="tech-item">{tech}</span>
          ))}
        </div>
      </header>

      <div class="content">
        <aside class="sidebar">
          <nav class="toc">
            <a href="#context" class="toc-link">{t.caseStudy.toc.context}</a>
            <a href="#challenges" class="toc-link">{t.caseStudy.toc.challenges}</a>
            <a href="#solution" class="toc-link">{t.caseStudy.toc.solution}</a>
            <a href="#implementation" class="toc-link">{t.caseStudy.toc.implementation}</a>
            <a href="#trade-offs" class="toc-link">{t.caseStudy.toc.tradeOffs}</a>
            <a href="#reliability" class="toc-link">{t.caseStudy.toc.reliability}</a>
            <a href="#results" class="toc-link">{t.caseStudy.toc.results}</a>
            <a href="#lessons" class="toc-link">{t.caseStudy.toc.lessons}</a>
          </nav>
        </aside>

        <div class="body">
          <slot />
        </div>
      </div>
    </article>
  </Container>
</BaseLayout>

<style>
  .case-study {
    padding: 48px 0 96px;
  }
  .header {
    margin-bottom: 64px;
  }
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 16px;
  }
  .description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin-bottom: 32px;
  }
  .hero-image {
    margin: 0 0 32px;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-tertiary);
  }
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .actions {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
  }
  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tech-item {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: var(--bg-tertiary);
  }
  .content {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 64px;
  }
  .sidebar {
    position: sticky;
    top: 96px;
    align-self: start;
  }
  .toc {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .toc-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition);
  }
  .toc-link:hover {
    color: var(--text-primary);
  }
  .body {
    min-width: 0;
  }
  .body :global(h2) {
    margin-top: 48px;
    margin-bottom: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 96px;
  }
  .body :global(h3) {
    margin-top: 32px;
    margin-bottom: 12px;
    scroll-margin-top: 96px;
  }
  .body :global(p) {
    margin-bottom: 16px;
  }
  .body :global(ul),
  .body :global(ol) {
    margin-bottom: 16px;
    padding-left: 20px;
  }
  .body :global(li) {
    margin-bottom: 8px;
  }
  .body :global(pre) {
    margin: 24px 0;
    max-width: 100%;
  }
  .body :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 16px;
    margin: 24px 0;
    color: var(--text-secondary);
    font-style: normal;
  }
  .body :global(table) {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 0.9375rem;
    display: block;
    overflow-x: auto;
  }
  .body :global(thead),
  .body :global(tbody),
  .body :global(tr) {
    width: 100%;
  }
  .body :global(th),
  .body :global(td) {
    border: 1px solid var(--border);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }
  .body :global(th) {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-weight: 600;
  }
  .body :global(td) {
    color: var(--text-secondary);
  }
  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }
  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .body :global(a:hover) {
    color: var(--accent-hover);
  }
  .body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin: 20px 0;
  }
  .body :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .body :global(code) {
    word-break: break-word;
  }
  @media (max-width: 768px) {
    .title {
      font-size: 1.75rem;
    }
    .content {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .sidebar {
      display: none;
    }
  }
</style>
