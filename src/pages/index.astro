---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import { SITE } from '../config/site';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featured = projects.filter((p) => p.data.featured);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  jobTitle: 'Analytics Engineer',
  sameAs: [SITE.links.github, SITE.links.linkedin],
  knowsAbout: ['Analytics Engineering', 'Data Engineering', 'Data Products', 'Data Architecture', 'ETL Pipelines', 'Business Intelligence'],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  author: { '@type': 'Person', name: SITE.author },
};
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  path="/"
  currentPath="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema, null, 2)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema, null, 2)} />

  <Container>
    <Hero />

    <SelectedWork projects={featured} />

    <section class="evidence" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading" class="evidence-heading">Engineering evidence</h2>
      <div class="evidence-grid">
        <div class="evidence-item">
          <span class="evidence-value">180</span>
          <span class="evidence-label">SkyCast tests green in GitHub Actions (verified run 9ec4a81)</span>
        </div>
        <div class="evidence-item">
          <span class="evidence-value">CI</span>
          <span class="evidence-label">workflows on SkyCast and GeoRisk_Finder — lint, tests, containers</span>
        </div>
        <div class="evidence-item">
          <span class="evidence-value">PyPI</span>
          <span class="evidence-label">RASPAL published as <code>raspal</code> (0.6.1, trusted publishing)</span>
        </div>
        <div class="evidence-item">
          <span class="evidence-value">Docker</span>
          <span class="evidence-label">reproducible environments for API, dashboard, and pipeline workloads</span>
        </div>
      </div>
    </section>

    <section class="approach" aria-labelledby="approach-heading">
      <h2 id="approach-heading" class="approach-heading">How I work</h2>
      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <h3 class="step-title">Understand</h3>
          <p class="step-desc">Map the business context and the decision that needs better information.</p>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <h3 class="step-title">Model</h3>
          <p class="step-desc">Design ingestion, transformation, storage, and access patterns before production code.</p>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <h3 class="step-title">Build</h3>
          <p class="step-desc">Ship pipelines, APIs, and interfaces with tests at every layer and validation at every boundary.</p>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <h3 class="step-title">Measure</h3>
          <p class="step-desc">Validate output against the original business problem — not just that it runs.</p>
        </div>
      </div>
      <p class="background-note">
        I ran a business before I built data systems. Managing inventory, costs, logistics, and margins taught me that data is only valuable when it helps someone make a better decision.
        <a href="/about"> More about my background &rarr;</a>
      </p>
    </section>

    <section class="cta">
      <h2 class="cta-heading">Interested in building reliable data systems close to business decisions?</h2>
      <p class="cta-text">
        I'm open to Analytics Engineer opportunities where engineering quality and business context matter.
      </p>
      <div class="cta-actions">
        <a href={SITE.links.email} class="cta-primary">Contact me</a>
        <a href={SITE.links.linkedin} target="_blank" rel="noopener noreferrer" class="cta-secondary">LinkedIn</a>
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="cta-secondary">Resume (PDF)</a>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  .evidence {
    padding: 48px 0;
    border-top: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .evidence-heading {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 28px;
  }
  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .evidence-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .evidence-value {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent);
  }
  .evidence-label {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .approach {
    padding: 48px 0 64px;
    border-top: 1px solid var(--border);
  }
  .approach-heading {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 28px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .step-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 6px 0;
  }
  .step-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .background-note {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 640px;
  }
  .background-note a {
    color: var(--accent);
    font-weight: 500;
  }

  .cta {
    padding: 64px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .cta-heading {
    font-size: 1.375rem;
    font-weight: 700;
    margin-bottom: 12px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-text {
    color: var(--text-secondary);
    margin-bottom: 28px;
    font-size: 0.9375rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    border-radius: 8px;
    background: var(--accent-solid);
    color: white;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background var(--transition);
  }
  .cta-primary:hover {
    background: var(--accent-solid-hover);
    color: white;
  }
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: border-color var(--transition), color var(--transition);
  }
  .cta-secondary:hover {
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }

  @media (max-width: 900px) {
    .evidence-grid,
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .evidence-grid,
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
