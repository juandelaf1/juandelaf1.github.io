---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import { SITE } from '../../config/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('approach');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} — ${SITE.author}`}
  description={entry.data.description}
  path={`/approach/${entry.id}`}
>
  <Container>
    <article class="principle-article">
      <header class="article-header">
        <p class="principle-label">Principle</p>
        <h1>{entry.data.title}</h1>
        <p class="principle-statement">{entry.data.principle}</p>
      </header>
      <div class="article-body">
        <Content />
      </div>
    </article>
  </Container>
</BaseLayout>

<style>
  .principle-article {
    padding: 48px 0 96px;
    max-width: 720px;
  }
  .article-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }
  .principle-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .article-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 16px;
  }
  .principle-statement {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.55;
    border-left: 2px solid var(--accent);
    padding-left: 16px;
  }
  .article-body :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 40px 0 16px;
  }
  .article-body :global(h3) {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 28px 0 12px;
  }
  .article-body :global(p) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .article-body :global(ol),
  .article-body :global(ul) {
    margin-bottom: 16px;
    padding-left: 24px;
  }
  .article-body :global(li) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 8px;
  }
  .article-body :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
