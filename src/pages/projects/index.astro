---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Metric from '../../components/ui/Metric.astro';
import { SITE } from '../../config/site';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const sorted = [...all].sort((a, b) => {
  const fa = a.data.featured ? 0 : 1;
  const fb = b.data.featured ? 0 : 1;
  if (fa !== fb) return fa - fb;
  return (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);
});
---

<BaseLayout
  title={`Projects — ${SITE.author}`}
  description="Case studies and projects: climate intelligence, logistics analytics, data extraction, and AI decision systems."
  path="/projects"
  currentPath="/projects"
>
  <Container>
    <section class="projects-index">
      <header class="page-header">
        <h1>Projects</h1>
        <p class="lede">
          Case studies with architecture, trade-offs, and verified results. Each link opens a full write-up or the public repository.
        </p>
      </header>

      <div class="group">
        <h2 class="group-heading">Case studies</h2>
        <div class="list">
          {sorted.map((project) => (
            <article class="item">
              <div class="item-main">
                <div class="item-meta">
                  <span class="category">{project.data.category}</span>
                  <span class="status">{project.data.status}</span>
                  {project.data.featured && <span class="badge">Featured</span>}
                </div>
                <h3 class="item-title">
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>
                <p class="item-desc">{project.data.description}</p>
                <div class="tech-row">
                  {project.data.tech.slice(0, 5).map((t) => (
                    <span class="tech">{t.name}</span>
                  ))}
                </div>
              </div>
              <div class="item-side">
                {project.data.metrics.slice(0, 2).map((m) => (
                  <Metric value={m.value} label={m.label} class="compact" />
                ))}
                <div class="item-links">
                  <a href={`/projects/${project.id}`}>Case study &rarr;</a>
                  {project.data.links.github && (
                    <a href={project.data.links.github} target="_blank" rel="noopener noreferrer">Repository</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <p class="note">
        Also see <a href="/experiments">experiments</a> for exploratory work, <a href="/building">building</a> for in-progress products, and <a href="/engineering">engineering notes</a> for production patterns.
      </p>
    </section>
  </Container>
</BaseLayout>

<style>
  .projects-index {
    padding: 48px 0 96px;
  }
  .page-header {
    margin-bottom: 48px;
  }
  .page-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .lede {
    color: var(--text-secondary);
    max-width: 560px;
  }
  .group {
    margin-bottom: 48px;
  }
  .group-heading {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 16px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    padding: 28px 32px;
    background: var(--bg-primary);
  }
  .item-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    padding: 2px 8px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .item-title {
    font-size: 1.1875rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .item-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .item-title a:hover {
    color: var(--accent);
  }
  .item-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 560px;
    margin-bottom: 12px;
  }
  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tech {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .item-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    min-width: 160px;
  }
  .item-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .item-links a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .item-links a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .note {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding-top: 8px;
  }
  .note a {
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .note a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 768px) {
    .item {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 24px;
    }
    .item-side {
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
      min-width: 0;
    }
  }
</style>
