---
export interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['monogram', className]}
  aria-hidden="true"
>
  <rect width="32" height="32" rx="6" fill="#0077B5" fill-opacity="0.12" />
  <text
    x="16"
    y="16"
    fill="#0077B5"
    font-family="JetBrains Mono, monospace"
    font-size="14"
    font-weight="700"
    text-anchor="middle"
    dominant-baseline="central"
  >JdF</text>
</svg>

<style>
  .monogram {
    flex-shrink: 0;
    transition: opacity var(--transition);
  }
  a:hover .monogram,
  .monogram:hover {
    opacity: 0.8;
  }
</style>
