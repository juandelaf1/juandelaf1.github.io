---
import { getUI } from '../../i18n/ui';
import { getLocaleFromUrl } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getUI(locale);

const year = new Date().getFullYear();
const base = locale === 'es' ? '/es' : '';
---

<footer class="footer">
  <div class="inner">
    <div class="bio">
      <p class="bio-role">{t.footer.role}</p>
      <p class="bio-tagline">{t.footer.tagline}</p>
    </div>
    <div class="links" aria-label="Footer">
      <a href={`${base}/projects`}>{t.nav.projects}</a>
      <a href={`${base}/approach`}>{t.nav.approach}</a>
      <a href={`${base}/about`}>{t.nav.about}</a>
      <a href={`${base}/experiments`}>{t.nav.experiments}</a>
      <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">{t.footer.resume}</a>
    </div>
    <p class="copyright">&copy; {year} Juan de la Fuente Larrocca</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 40px 0;
    margin-top: 32px;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bio-role {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 500;
  }
  .bio-tagline {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    max-width: 320px;
    line-height: 1.4;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .links a {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition);
  }
  .links a:hover {
    color: var(--text-primary);
  }
  .copyright {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    width: 100%;
    text-align: center;
    margin-top: 8px;
  }
  @media (max-width: 768px) {
    .inner {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
    .bio-tagline {
      max-width: none;
    }
    .links {
      justify-content: center;
    }
  }
</style>
