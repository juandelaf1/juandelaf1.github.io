---
import { getUI } from '../../i18n/ui';
import { getAlternateUrl, getLocaleFromUrl } from '../../i18n/utils';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = getUI(locale);
const altUrl = getAlternateUrl(currentPath, locale);

const NAV = [
  { label: t.nav.projects, href: locale === 'es' ? '/es/projects' : '/projects' },
  { label: t.nav.approach, href: locale === 'es' ? '/es/approach' : '/approach' },
  { label: t.nav.about, href: locale === 'es' ? '/es/about' : '/about' },
];

function isActive(href: string): boolean {
  if (href === '/' || href === '/es') return currentPath === href;
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="header">
  <nav class="nav" aria-label="Main">
    <a href={locale === 'es' ? '/es' : '/'} class="logo">
      <img src="/logo.svg" alt="Juan de la Fuente" width="160" height="36" class="logo-img" />
    </a>
    <div class="links">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={{ link: true, active: isActive(item.href) }}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href={altUrl} class="lang-switch" aria-label={t.language.label}>
        {t.language.switch}
      </a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 12px var(--content-padding);
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo-img {
    height: 36px;
    width: auto;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition);
  }
  .link:hover {
    color: var(--text-primary);
  }
  .active {
    color: var(--text-primary);
  }
  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 999px;
    padding: 4px 12px;
    transition: border-color var(--transition), background var(--transition);
  }
  .lang-switch:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .links {
      gap: 16px;
    }
    .link {
      font-size: 0.8125rem;
    }
    .logo-img {
      height: 28px;
    }
  }
</style>
