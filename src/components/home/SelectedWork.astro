---
import type { CollectionEntry } from 'astro:content';
import Metric from '../ui/Metric.astro';
import MiniFlow from '../projects/MiniFlow.astro';

export interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const sorted = [...projects].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const flowMap: Record<string, string[]> = {
  case: ['Input', 'Prompt', 'LLM', 'Validate', 'Decide'],
  'sky-cast': ['AEMET', 'Ingest', 'Store', 'API', 'Dashboard'],
  'raspal-scraper': ['URL', 'Scrape', 'Extract', 'Validate', 'JSON'],
  'dash-logistics': ['Sources', 'ETL', 'Model', 'KPIs', 'Dashboard'],
};
---

<section class="selected-work" aria-labelledby="selected-heading">
  <div class="section-head">
    <h2 id="selected-heading" class="heading">Selected work</h2>
    <a href="/projects" class="view-all">View all projects &rarr;</a>
  </div>
  <div class="grid">
    {sorted.map((project) => (
      <a href={`/projects/${project.id}`} class="card">
        <div class="card-content">
          <div class="card-header">
            <span class="category">{project.data.category}</span>
            <span class="status">{project.data.status}</span>
          </div>
          {flowMap[project.id] && (
            <div class="card-flow">
              <MiniFlow nodes={flowMap[project.id]} />
            </div>
          )}
          <h3 class="card-title">{project.data.title}</h3>
          <p class="card-description">{project.data.description}</p>
          {project.data.metrics.length > 0 && (
            <div class="card-metrics">
              {project.data.metrics.slice(0, 2).map((m) => (
                <Metric value={m.value} label={m.label} />
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .selected-work {
    padding: 0 0 80px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .view-all {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .view-all:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .card {
    display: block;
    background: var(--bg-primary);
    padding: 28px 32px;
    text-decoration: none;
    transition: background var(--transition);
  }
  .card:hover {
    background: var(--bg-secondary);
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 0;
  }
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card-flow {
    margin: 2px 0;
  }
  .card-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .card-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .card-metrics {
    display: flex;
    gap: 24px;
    margin-top: auto;
    padding-top: 8px;
  }
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 24px;
    }
  }
</style>
