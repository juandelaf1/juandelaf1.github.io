---
import type { CollectionEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Metric from '../ui/Metric.astro';
import MiniFlow from '../projects/MiniFlow.astro';
import { getUI } from '../../i18n/ui';
import { getLocaleFromUrl } from '../../i18n/utils';

export interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const locale = ((Astro.currentLocale as 'en' | 'es') ?? getLocaleFromUrl(Astro.url));
const t = getUI(locale);
const sorted = [...projects].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

function slugOf(id: string): string {
  return id.replace(/^(en|es)\//, '');
}

const flowMap: Record<string, string[]> = {
  case: ['Input', 'Prompt', 'LLM', 'Validate', 'Decide'],
  'sky-cast': ['AEMET', 'Ingest', 'Store', 'API', 'Dashboard'],
  'raspal-scraper': ['URL', 'Scrape', 'Extract', 'Validate', 'JSON'],
  'dash-logistics': ['Sources', 'ETL', 'Model', 'KPIs', 'Dashboard'],
};

function thumbFor(imagePath?: string): string | undefined {
  if (!imagePath) return undefined;
  const thumbPath = imagePath.replace(/(\.[^.]+)$/, '-thumb$1');
  const publicFile = path.join(process.cwd(), 'public', thumbPath.replace(/^\//, ''));
  return fs.existsSync(publicFile) ? thumbPath : imagePath;
}
---

<section class="selected-work" aria-labelledby="selected-heading">
  <div class="section-head">
    <h2 id="selected-heading" class="heading">{t.home.selectedWork}</h2>
    <a href={locale === 'es' ? '/es/projects' : '/projects'} class="view-all">
      {t.home.viewAll}
    </a>
  </div>
  <div class="grid">
    {sorted.map((project) => {
      const slug = slugOf(project.id);
      return (
        <a href={locale === 'es' ? `/es/projects/${slug}` : `/projects/${slug}`} class="card">
          {project.data.image && (
            <div class="card-thumb">
              <img
                src={thumbFor(project.data.image)}
                alt={project.data.title}
                loading="lazy"
              />
            </div>
          )}
          <div class="card-content">
            <div class="card-header">
              <span class="category">{project.data.category}</span>
              <span class="status">{project.data.status}</span>
            </div>
            {flowMap[slug] && (
              <div class="card-flow">
                <MiniFlow nodes={flowMap[slug]} />
              </div>
            )}
            <h3 class="card-title">{project.data.title}</h3>
            <p class="card-description">{project.data.description}</p>
            {project.data.metrics.length > 0 && (
              <div class="card-metrics">
                {project.data.metrics.slice(0, 2).map((m) => (
                  <Metric value={m.value} label={m.label} />
                ))}
              </div>
            )}
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .selected-work {
    padding: 0 0 80px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .view-all {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .view-all:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .grid > .card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .grid > .card {
    min-width: 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    padding: 0;
    text-decoration: none;
    transition: background var(--transition);
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
  }
  .card-thumb {
    margin: 0;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    background: var(--bg-tertiary);
    aspect-ratio: 21 / 9;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    line-height: 0;
    flex-shrink: 0;
    position: relative;
    box-sizing: border-box;
    contain: layout paint;
  }
  .card-thumb img {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: block;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
    object-position: center;
    border-radius: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .card:hover {
    background: var(--bg-secondary);
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 0;
  }
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 24px 28px 28px;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card-flow {
    margin: 2px 0;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }
  .card-flow :global(svg),
  .card-flow :global(.mini-flow) {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
  }
  .card-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .card-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .card-metrics {
    display: flex;
    gap: 24px;
    margin-top: auto;
    padding-top: 8px;
  }
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid > .card:last-child:nth-child(odd) {
      grid-column: auto;
    }
    .card-content {
      padding: 20px;
    }
  }
</style>
