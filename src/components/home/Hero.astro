---
import Button from '../ui/Button.astro';
import Monogram from '../ui/Monogram.astro';
import { SITE } from '../../config/site';
import { getUI } from '../../i18n/ui';
import { getLocaleFromUrl } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getUI(locale);
const projectsUrl = locale === 'es' ? '/es/projects' : '/projects';
---

<section class="hero">
  <div class="content">
    <div class="name-row">
      <Monogram size={48} />
      <div>
        <h1 class="name">Juan de la Fuente</h1>
        <p class="position">{t.hero.position}</p>
      </div>
    </div>
    <p class="tagline">
      {t.hero.tagline}
    </p>
    <p class="differentiator">
      {t.hero.differentiator}
    </p>
    <div class="actions">
      <Button href={projectsUrl} variant="primary">{t.hero.ctaProjects}</Button>
      <Button href="/resume.pdf" variant="ghost" external>{t.hero.ctaResume}</Button>
      <Button href={SITE.links.github} variant="ghost" external>{t.hero.ctaGithub}</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 112px 0 72px;
  }
  .content {
    max-width: 720px;
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .name {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0;
    line-height: 1.1;
  }
  .position {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--accent);
    margin-bottom: 0;
    margin-top: 4px;
  }
  .tagline {
    font-size: 1.1875rem;
    color: var(--text-primary);
    line-height: 1.55;
    margin-bottom: 16px;
    max-width: 600px;
  }
  .differentiator {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 560px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 768px) {
    .hero {
      padding: 72px 0 48px;
    }
    .name-row {
      gap: 12px;
    }
    .name {
      font-size: 2rem;
    }
    .tagline {
      font-size: 1.0625rem;
    }
  }
</style>
