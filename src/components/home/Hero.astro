---
import Button from '../ui/Button.astro';
import Monogram from '../ui/Monogram.astro';
import { SITE } from '../../config/site';
---

<section class="hero">
  <div class="content">
    <div class="name-row">
      <Monogram size={48} />
      <div>
        <h1 class="name">Juan de la Fuente</h1>
        <p class="position">Analytics Engineer · Data Products</p>
      </div>
    </div>
    <p class="tagline">
      I design and build production data systems. Pipelines, APIs, models, and interactive products that turn data into decisions.
    </p>
    <p class="differentiator">
      Before engineering data, I ran a business. That experience shapes every system I build — from understanding the real problem to shipping something that works.
    </p>
    <div class="actions">
      <Button href="/projects" variant="primary">Explore projects</Button>
      <Button href="/resume.pdf" variant="ghost" external>Resume (PDF)</Button>
      <Button href={SITE.links.github} variant="ghost" external>GitHub</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 112px 0 72px;
  }
  .content {
    max-width: 720px;
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .name {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0;
    line-height: 1.1;
  }
  .position {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--accent);
    margin-bottom: 0;
    margin-top: 4px;
  }
  .tagline {
    font-size: 1.1875rem;
    color: var(--text-primary);
    line-height: 1.55;
    margin-bottom: 16px;
    max-width: 600px;
  }
  .differentiator {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 560px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 768px) {
    .hero {
      padding: 72px 0 48px;
    }
    .name-row {
      gap: 12px;
    }
    .name {
      font-size: 2rem;
    }
    .tagline {
      font-size: 1.0625rem;
    }
  }
</style>
